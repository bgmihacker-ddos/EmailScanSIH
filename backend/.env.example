APP_NAME=Email Threat Detection Platform
ENVIRONMENT=production
DEBUG=false

# Primary app database. For Supabase, use the PostgreSQL connection string provided in
# Project Settings -> Database -> Connection string (Session mode or Direct URL).
# Example: postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Optional Supabase-specific config for future client integrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Required for auth endpoints in production. Generate a strong random value in Render.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional threat intelligence providers. Leave empty until keys are available.
THREATFOX_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
HIBP_API_KEY=

# Optional public-IP geolocation provider for /api/live-threats. Coordinates are only
# returned when this provider successfully resolves a routable IP address.
GEOLOCATION_API_URL=https://ipapi.co
GEOLOCATION_API_TIMEOUT_SECONDS=3

# Comma-separated frontend origins. Do not include paths like /login.
CORS_ORIGINS=https://email-threat-detecion1.vercel.app,https://sih-2026-project-blush.vercel.app,http://localhost:5173
